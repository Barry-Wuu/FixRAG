# 复制为 .env 并填入你的 DashScope key（也可不填，代码会自动读取 D:\B++\.env 或 /mnt/d/B++/.env）
DASHSCOPE_API_KEY=sk-ws-xxxxxxxxxxxxxxxxxxxxxxxx

# 知识库源文档目录（WSL 下用 /mnt/d/... 路径）
EDURAG_DATA_DIR=D:\黑马AI大模型软件\10.EduRAG与智能体\Itcast_qa_system\rag_qa\data\ai_data

# 意图识别模型
EDURAG_MODEL_PATH=D:\models\EDURAG.rf.joblib

# 模型选择（你 key 可用：qwen-max / qwen-plus / qwen-turbo / qwen-long）
EDURAG_LLM_MODEL=qwen-plus
EDURAG_EMBED_MODEL=text-embedding-v1

# 可选：强制检索策略 auto/direct/hyde/sub_query/backtrack
# EDURAG_STRATEGY=auto
